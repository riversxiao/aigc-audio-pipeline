      "placement": "sequential",
      "gain_db": 0.0,
      "gap_after_s": 0.32,
      "director_note": "陆烬握紧断岳踏上虚空台阶，一针见血痛斥顾长渊当年之败与姜清凰之苦"
    },
    {
