      "placement": "sequential",
      "gain_db": 0.5,
      "gap_after_s": 0.25,
      "director_note": "清晨北渊秋雨洗刷青石长街，遥相呼应全书开篇母题"
    },
    {
      "cue_id": "c004_nar_p007",
