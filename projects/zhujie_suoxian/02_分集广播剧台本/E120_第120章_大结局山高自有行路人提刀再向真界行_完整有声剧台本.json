    {
      "cue_id": "c008_nar_p014",
      "act_id": "act1_beiyuan_autumn_rain_young_wayfarer",
      "kind": "dialogue",
      "role_id": "narrator",
      "speaker_name": "",
      "text": "[dramatically] 念罢，十八岁的布衣少年挺直脊梁，对着青石碑与身后的陆氏旧祠重重抱拳行了一礼，随即转身大步流星地踏碎街面积水，朝着城北向天下寒门敞开大门的【断岳武院】奔去！祠堂飞檐下的廊柱旁，无人察觉的清风微微一旋。一袭青衫的陆烬静静站在檐下，看着那个背着熟铁阔刀消失在秋雨巷口里的倔强背影，仿佛隔着数十载波澜壮阔的岁月，看见了当年那个在漏雨祠堂里攥着退婚书碎片、咬牙擦干嘴角鲜血的自己。只是当年的陆烬只能在绝境黑夜里孤身摸索，而如今这个少年的前方，已是阳光普照、五阶敞开的康庄大道。",
      "tts_text": "",
      "stability": 0.0,
      "similarity_boost": 0.85,
      "acoustic_space": "dry",
      "motif_id": "",
      "sfx_prompt": "",
      "duration_seconds": 2.5,
      "prompt_influence": 0.55,
      "loop": false,
      "placement": "sequential",
      "gain_db": 0.0,
