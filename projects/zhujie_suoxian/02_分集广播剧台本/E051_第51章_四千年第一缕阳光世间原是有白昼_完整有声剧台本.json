      "kind": "dialogue",
      "role_id": "narrator",
      "speaker_name": "",
      "text": "一双清澈明亮、从未被半丝妖火污染过的秀美星眸在晨光中轻轻眨动了数下，待适应了那漫天绚烂金辉后，沈烛音终于亲眼看见了石窟壁画上先祖描绘了整整四千年的那轮金色烈日，也看清了半空中陆烬那道负刀而立的玄青挺拔身影。",
      "tts_text": "",
      "stability": 0.5,
      "similarity_boost": 0.85,
      "acoustic_space": "dry",
      "motif_id": "",
      "sfx_prompt": "",
      "duration_seconds": 2.5,
