    {
      "cue_id": "c025_nar_p037",
      "act_id": "act2_shatter_god_crown_keep_mortal_name",
      "kind": "dialogue",
      "role_id": "narrator",
      "speaker_name": "",
      "text": "识海之内，白发飞舞的陆烬静静看着眼前浮现的那顶太初神冠。神冠之上流转着创世之初的无垠星辉，甚至隐隐映照出九个纪元前万族朝拜始祖的恢宏画卷。若换作任何一个贪图神力与永恒的修士，面对唾手可得的创世古神位格，恐怕连千分之一息都不会犹豫。而在识海四周，三座早已与他融为一体的魂龛余影也同时泛起微光。",
      "tts_text": "",
      "stability": 0.5,
      "similarity_boost": 0.85,
