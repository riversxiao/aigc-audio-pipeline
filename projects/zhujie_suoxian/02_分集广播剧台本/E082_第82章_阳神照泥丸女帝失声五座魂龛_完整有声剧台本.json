      "kind": "dialogue",
      "role_id": "narrator",
      "speaker_name": "",
      "text": "陆烬指尖摩挲着膝上【断岳·斩锁刀】冰冷的刀脊，继续以刀意刻冰发问：",
      "tts_text": "",
      "stability": 0.5,
      "similarity_boost": 0.85,
      "acoustic_space": "mental_realm",
      "motif_id": "",
      "sfx_prompt": "",
      "duration_seconds": 2.5,
