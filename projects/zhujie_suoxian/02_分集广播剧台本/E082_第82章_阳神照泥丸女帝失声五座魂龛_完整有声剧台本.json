      "act_id": "act3_frost_coffin_ice_carving_origin_womb",
      "kind": "dialogue",
      "role_id": "jiang_qinghuang",
      "speaker_name": "",
      "text": "[coldly] [dramatically] 你在元婴与化神初期不开三阶锁，他们便只能隔着封门做些手脚，无法强夺你的肉身控制权。可你一旦在第六界冲击【第三阶基因锁】掀开泥丸底层黑匣，脊柱里那头魔主凶魂与视神经里的仙庭木马必会第一时间扑出来噬主夺壳！",
      "tts_text": "",
      "stability": 0.0,
      "similarity_boost": 0.85,
      "acoustic_space": "mental_realm",
      "motif_id": "",
      "sfx_prompt": "",
      "duration_seconds": 2.5,
      "prompt_influence": 0.55,
      "loop": false,
      "placement": "sequential",
      "gain_db": 0.0,
      "gap_after_s": 0.32,
      "director_note": "姜清凰警告一旦在第六界冲击三阶锁必引脊柱魔魂与视神经木马夺壳"
    },
