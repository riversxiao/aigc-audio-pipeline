    {
      "cue_id": "c032_qin_lie_p028",
      "act_id": "act2_one_armed_veteran_father_slays_core",
      "kind": "dialogue",
      "role_id": "qin_lie",
      "speaker_name": "铁山",
      "text": "[calmly] 两年前的一个夜里，擎苍背着一把临时抢来的黑铁重刀摸进鬼市，认出了我门头的断刀雪莲纹！那时候他刚修至紫府中期，借我这炉火修补了破碎内甲，我们叔侄俩在地窖里彻夜长谈了一宿。",
      "tts_text": "",
      "stability": 0.5,
      "similarity_boost": 0.85,
      "acoustic_space": "dry",
      "motif_id": "",
      "sfx_prompt": "",
      "duration_seconds": 2.5,
      "prompt_influence": 0.55,
      "loop": false,
      "placement": "sequential",
      "gain_db": 0.0,
      "gap_after_s": 0.32,
      "director_note": "铁山拧开铁砧底座机括讲述两年前叔侄重逢"
