      "kind": "dialogue",
      "role_id": "narrator",
      "speaker_name": "",
      "text": "铁山用力点头，一边摸索着拧开铁砧底座的机括，一边快速说道。",
      "tts_text": "",
      "stability": 0.5,
      "similarity_boost": 0.85,
      "acoustic_space": "dry",
