      "gap_after_s": 0.28,
      "director_note": "旁白叙事（声场：dry）"
    },
    {
      "cue_id": "c022_lu_jin_p023",
      "act_id": "act2_one_armed_veteran_father_slays_core",
      "kind": "dialogue",
      "role_id": "lu_jin",
      "speaker_name": "",
      "text": "[softly] [calmly] 晚辈正是陆烬。敢问前辈尊姓大名，可是当年随上一代镇渊老司主踏入天渊的旧部前辈？",
      "tts_text": "",
      "stability": 0.5,
      "similarity_boost": 0.85,
      "acoustic_space": "dry",
      "motif_id": "",
      "sfx_prompt": "",
      "duration_seconds": 2.5,
      "prompt_influence": 0.55,
      "loop": false,
      "placement": "sequential",
      "gain_db": 0.0,
      "gap_after_s": 0.32,
      "director_note": "陆烬扶住老人温声询问"
    },
    {
      "cue_id": "c023_nar_p024",
      "act_id": "act2_one_armed_veteran_father_slays_core",
      "kind": "dialogue",
      "role_id": "narrator",
      "speaker_name": "",
      "text": "老汉用衣袖胡乱抹了一把老泪，挺起佝偻的脊背瓮声道。",
      "tts_text": "老汉用衣袖胡乱抹了一把老泪，挺起沟楼的脊背瓮声道。",
      "stability": 0.5,
      "similarity_boost": 0.85,
      "acoustic_space": "dry",
      "motif_id": "",
      "sfx_prompt": "",
      "duration_seconds": 2.5,
      "prompt_influence": 0.55,
      "loop": false,
      "placement": "sequential",
      "gain_db": 0.0,
