      "stability": 0.0,
      "similarity_boost": 0.85,
      "acoustic_space": "dry",
      "motif_id": "",
      "sfx_prompt": "",
      "duration_seconds": 2.5,
      "prompt_influence": 0.55,
      "loop": false,
      "placement": "sequential",
      "gain_db": 0.0,
      "gap_after_s": 0.32,
      "director_note": "铁山咬牙讲述被塔灵烧瞎双目削去左臂之恨"
    },
    {
      "cue_id": "c027_nar_p026",
      "act_id": "act2_one_armed_veteran_father_slays_core",
      "kind": "dialogue",
      "role_id": "narrator",
      "speaker_name": "",
      "text": "说到此处，铁山脸上涌起难以抑制的振奋红光，拉着陆烬走到后堂地窖暗格前，压低声音急切道。",
      "tts_text": "",
      "stability": 0.5,
      "similarity_boost": 0.85,
      "acoustic_space": "dry",
      "motif_id": "",
      "sfx_prompt": "",
      "duration_seconds": 2.5,
      "prompt_influence": 0.55,
      "loop": false,
      "placement": "sequential",
      "gain_db": 0.0,
      "gap_after_s": 0.28,
      "director_note": "旁白叙事（声场：dry）"
    },
    {
