    {
      "cue_id": "c024_qin_lie_p024",
      "act_id": "act2_one_armed_veteran_father_slays_core",
      "kind": "dialogue",
      "role_id": "qin_lie",
      "speaker_name": "铁山",
      "text": "[hoarsely] [dramatically] 老奴铁山，原北渊镇渊司左卫铸兵统领！二十年前老司主察觉大苍血月有异，率我们十二名死士闯入天渊探路，结果十一人死在跨界风暴里，老司主重伤坐化前将老奴推入此界。",
      "tts_text": "",
      "stability": 0.5,
      "similarity_boost": 0.85,
      "acoustic_space": "dry",
      "motif_id": "",
      "sfx_prompt": "",
      "duration_seconds": 2.5,
      "prompt_influence": 0.55,
      "loop": false,
      "placement": "sequential",
      "gain_db": 0.0,
      "gap_after_s": 0.32,
      "director_note": "铁山抹泪挺脊自报镇渊司旧职与二十年前探路往事"
    },
    {
