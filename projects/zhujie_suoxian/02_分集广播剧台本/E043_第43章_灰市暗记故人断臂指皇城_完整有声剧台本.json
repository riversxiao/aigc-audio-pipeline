    {
      "cue_id": "c033_nar_p029",
      "act_id": "act2_one_armed_veteran_father_slays_core",
      "kind": "dialogue",
      "role_id": "narrator",
      "speaker_name": "",
      "text": "陆烬凝神静听，不放过任何一个细节。",
      "tts_text": "",
      "stability": 0.5,
      "similarity_boost": 0.85,
      "acoustic_space": "dry",
      "motif_id": "",
      "sfx_prompt": "",
      "duration_seconds": 2.5,
