    {
      "cue_id": "c034_nar_p030",
      "act_id": "act2_one_armed_veteran_father_slays_core",
      "kind": "dialogue",
      "role_id": "narrator",
      "speaker_name": "",
      "text": "铁山从暗格底层捧出一只用火油布层层裹紧的狭长铁匣，沉声讲述道。",
      "tts_text": "",
      "stability": 0.5,
      "similarity_boost": 0.85,
      "acoustic_space": "dry",
      "motif_id": "",
      "sfx_prompt": "",
      "duration_seconds": 2.5,
      "prompt_influence": 0.55,
      "loop": false,
      "placement": "sequential",
      "gain_db": 0.0,
      "gap_after_s": 0.28,
      "director_note": "旁白叙事（声场：dry）"
    },
    {
      "cue_id": "c035_qin_lie_p030",
      "act_id": "act2_one_armed_veteran_father_slays_core",
      "kind": "dialogue",
      "role_id": "qin_lie",
      "speaker_name": "铁山",
      "text": "[dramatically] 擎苍何等敏锐，他在灰原郡与皇城潜伏数月，早已查清这座【烬昼无日界】的惊天骗局！少主，这方世界的天空根本不是天生永夜，而是四千年前有一件天外降下的母锁沉入了东边皇城【永夜圣京】地底的【熄灯古井】，生生吞没了漫天日光，还把全天下活人的眼睛基因都给改瞎了！",
      "tts_text": "",
      "stability": 0.0,
      "similarity_boost": 0.85,
      "acoustic_space": "dry",
      "motif_id": "",
