      "gain_db": 0.0,
      "gap_after_s": 0.32,
      "director_note": "铁山焦黑眼眶涌出热泪摸着陆烬眉骨哽咽相认"
    },
    {
      "cue_id": "c021_nar_p023",
      "act_id": "act2_one_armed_veteran_father_slays_core",
      "kind": "dialogue",
      "role_id": "narrator",
      "speaker_name": "",
      "text": "陆烬见老人如此真情流露，心中最后一丝戒备彻底散去，扶住就要大礼参拜的老汉手臂。",
      "tts_text": "",
      "stability": 0.5,
      "similarity_boost": 0.85,
