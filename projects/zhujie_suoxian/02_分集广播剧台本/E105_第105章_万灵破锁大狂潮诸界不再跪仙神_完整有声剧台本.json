      "kind": "dialogue",
      "role_id": "narrator",
      "speaker_name": "",
      "text": "众人目光齐齐落在陆烬手中的八角令牌上。",
      "tts_text": "",
      "stability": 0.5,
      "similarity_boost": 0.85,
