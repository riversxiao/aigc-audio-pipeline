      "kind": "dialogue",
      "role_id": "jiang_qinghuang",
      "speaker_name": "",
      "text": "[calmly] 别直接用蛮力震碎它。",
      "tts_text": "",
      "stability": 0.5,
      "similarity_boost": 0.85,
      "acoustic_space": "vast_hall",
      "motif_id": "",
