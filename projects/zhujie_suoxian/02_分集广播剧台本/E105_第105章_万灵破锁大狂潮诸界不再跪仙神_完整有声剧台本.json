      "motif_id": "",
      "sfx_prompt": "",
      "duration_seconds": 2.5,
      "prompt_influence": 0.55,
      "loop": false,
      "placement": "sequential",
      "gain_db": 0.0,
      "gap_after_s": 0.32,
      "director_note": "陆擎苍踏空掠来怒斥仙庭毒计"
    },
    {
      "cue_id": "c010_nar_p017",
      "act_id": "act1_inspect_central_token_deadly_backlash",
      "kind": "dialogue",
      "role_id": "narrator",
      "speaker_name": "",
      "text": "后方玄黄战舰的舰首之上，独臂横提阔刀的陆擎苍踏空掠来，苍劲面庞上溅满天兵金血，沉声骂了一句。",
      "tts_text": "",
      "stability": 0.5,
      "similarity_boost": 0.85,
      "acoustic_space": "vast_hall",
      "motif_id": "",
