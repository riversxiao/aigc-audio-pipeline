      "gain_db": 0.0,
      "gap_after_s": 0.32,
      "director_note": "陆烬借孤本古籍将太阳解释为天穹巨灯代称"
    },
    {
      "cue_id": "c009_nar_p012",
      "act_id": "act1_ancient_scroll_excuse_board_caravan",
      "kind": "dialogue",
      "role_id": "narrator",
      "speaker_name": "",
      "text": "这一番半真半假的说辞合情合理，既解释了他为何不识外头规矩，又给了众人一个台阶。陈福与周青对视一眼，紧绷到极点的脊背顿时垮了下来，两人同时长长吐出一口浊气。",
      "tts_text": "",
      "stability": 0.5,
      "similarity_boost": 0.85,
      "acoustic_space": "dry",
      "motif_id": "",
      "sfx_prompt": "",
