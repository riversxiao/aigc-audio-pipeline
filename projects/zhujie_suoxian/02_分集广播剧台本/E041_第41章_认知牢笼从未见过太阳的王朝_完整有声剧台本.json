      "kind": "dialogue",
      "role_id": "narrator",
      "speaker_name": "",
      "text": "在【破妄真目】的注视下，陈福与周青的心跳频率、气血走向乃至瞳孔微缩的反应尽收眼底，没有半分作伪的痕迹。他们是真的听不懂什么叫“天亮”，也真的从未听过“太阳”这两个字。",
      "tts_text": "",
      "stability": 0.5,
      "similarity_boost": 0.85,
      "acoustic_space": "dry",
      "motif_id": "",
      "sfx_prompt": "",
      "duration_seconds": 2.5,
      "prompt_influence": 0.55,
      "loop": false,
      "placement": "sequential",
      "gain_db": 0.0,
      "gap_after_s": 0.28,
      "director_note": "旁白叙事（声场：dry）"
    },
    {
