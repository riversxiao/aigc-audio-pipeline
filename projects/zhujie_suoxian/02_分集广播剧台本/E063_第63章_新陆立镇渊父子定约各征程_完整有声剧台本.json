      "act_id": "act2_cliffside_wine_father_son_pact",
      "kind": "dialogue",
      "role_id": "lu_jin",
      "speaker_name": "",
      "text": "[softly] [dramatically] 等我打穿前路，推开识海最深处那座古棺，把天上那座把众生当牲畜圈养的【司命仙庭】彻底掀翻之日，儿子再架起万界星桥，接爹和福伯、铁山前辈他们天外重聚！",
      "tts_text": "",
      "stability": 0.0,
      "similarity_boost": 0.85,
      "acoustic_space": "dry",
      "motif_id": "",
      "sfx_prompt": "",
      "duration_seconds": 2.5,
      "prompt_influence": 0.55,
      "loop": false,
      "placement": "sequential",
      "gain_db": 0.0,
      "gap_after_s": 0.32,
      "director_note": "陆烬端起粗陶酒碗郑重立下掀翻仙庭、天外重聚之约"
    },
    {
      "cue_id": "c034_lu_qingcang_p042",
      "act_id": "act2_cliffside_wine_father_son_pact",
      "kind": "dialogue",
      "role_id": "lu_qingcang",
      "speaker_name": "",
      "text": "[laughs] [shouting] 哈哈哈哈，有你这句话，老子在这儿再守五十年也不嫌闷！",
      "tts_text": "",
      "stability": 0.0,
      "similarity_boost": 0.85,
      "acoustic_space": "dry",
