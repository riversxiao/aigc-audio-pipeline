    },
    {
      "cue_id": "c022_nar_p029",
      "act_id": "act2_cliffside_wine_father_son_pact",
      "kind": "dialogue",
      "role_id": "narrator",
      "speaker_name": "",
      "text": "陆擎苍独臂重重拍了拍自己胸膛，坦荡洒脱地大声道。",
