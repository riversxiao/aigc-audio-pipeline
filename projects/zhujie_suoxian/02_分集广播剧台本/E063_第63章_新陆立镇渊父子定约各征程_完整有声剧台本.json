      "gap_after_s": 0.32,
      "director_note": "陆擎苍独臂高举粗陶大碗为儿壮行"
    },
    {
      "cue_id": "c037_lu_jin_p044",
      "act_id": "act2_cliffside_wine_father_son_pact",
      "kind": "dialogue",
      "role_id": "lu_jin",
      "speaker_name": "",
      "text": "[fiercely] [shouting] 干！",
      "tts_text": "",
      "stability": 0.0,
      "similarity_boost": 0.85,
      "acoustic_space": "dry",
      "motif_id": "",
      "sfx_prompt": "",
      "duration_seconds": 2.5,
      "prompt_influence": 0.55,
      "loop": false,
      "placement": "sequential",
      "gain_db": 0.0,
      "gap_after_s": 0.32,
      "director_note": "父子海崖碰碗一饮而尽"
    },
    {
      "cue_id": "c038_nar_p045",
      "act_id": "act2_cliffside_wine_father_son_pact",
      "kind": "dialogue",
      "role_id": "narrator",
      "speaker_name": "",
      "text": "千丈海崖绝顶，暮色苍茫，沧海浩瀚。两只粗陶大碗在半空中“啪”地重重撞在一处，辛辣滚烫的酒水溅湿了父子二人的衣襟，两人同时仰头一饮而尽！",
      "tts_text": "",
