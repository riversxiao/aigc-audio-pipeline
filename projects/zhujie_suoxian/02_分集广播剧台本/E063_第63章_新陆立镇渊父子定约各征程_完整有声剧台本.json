    },
    {
      "cue_id": "c041_nar_p050",
      "act_id": "act2_cliffside_wine_father_son_pact",
      "kind": "dialogue",
      "role_id": "narrator",
      "speaker_name": "",
      "text": "海崖之上，陆擎苍独臂拄着【镇岳】阔刀，一直目送着儿子的背影没入九天云霞天门彻底消失，这才抹了一把眼角被海风吹出的湿意，转身大步流星走向灯火通明的镇渊城。",
      "tts_text": "",
      "stability": 0.5,
      "similarity_boost": 0.85,
      "acoustic_space": "dry",
      "motif_id": "",
      "sfx_prompt": "",
      "duration_seconds": 2.5,
      "prompt_influence": 0.55,
      "loop": false,
