    },
    {
      "cue_id": "c023_lu_qingcang_p029",
      "act_id": "act2_cliffside_wine_father_son_pact",
      "kind": "dialogue",
      "role_id": "lu_qingcang",
      "speaker_name": "",
      "text": "[dramatically] 那座仙桥里漏出来的一丝丝法则威压，连爹看着都眼皮直跳，对面定是元婴老怪满天飞的高阶大界！爹如今才刚破金丹初期，跟着你跨过去非但替你挡不了一刀半剑，反倒成了捆住你手脚的拖油瓶！",
      "tts_text": "",
      "stability": 0.0,
      "similarity_boost": 0.85,
      "acoustic_space": "dry",
      "motif_id": "",
      "sfx_prompt": "",
      "duration_seconds": 2.5,
      "prompt_influence": 0.55,
      "loop": false,
      "placement": "sequential",
      "gain_db": 0.0,
      "gap_after_s": 0.32,
      "director_note": "陆擎苍直言对面是元婴大界，绝不做儿子的拖油瓶"
    },
    {
      "cue_id": "c024_nar_p030",
      "act_id": "act2_cliffside_wine_father_son_pact",
      "kind": "dialogue",
      "role_id": "narrator",
      "speaker_name": "",
      "text": "他盯着儿子的眼睛，语气无比认真。",
