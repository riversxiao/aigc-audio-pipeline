      "kind": "dialogue",
      "role_id": "lu_qingcang",
      "speaker_name": "",
      "text": "[dramatically] [shouting] 来，干了这碗践行酒，莫让对面那些元婴老怪小瞧了咱们北渊陆氏的刀！",
      "tts_text": "",
      "stability": 0.0,
      "similarity_boost": 0.85,
