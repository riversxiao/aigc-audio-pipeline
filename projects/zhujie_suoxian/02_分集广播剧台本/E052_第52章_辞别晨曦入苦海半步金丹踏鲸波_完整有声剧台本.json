    {
      "cue_id": "c015_su_qinghan_p019",
      "act_id": "act2_city_gate_farewell_dragon_pearl",
      "kind": "dialogue",
      "role_id": "su_qinghan",
      "speaker_name": "沈烛音",
      "text": "[softly] [dramatically] 陆少侠劈碎永夜、斩灭国师，于我【烬昼】亿万生灵有再造天地之大恩，我等无以为报。这枚【定海龙珠】乃是昔年大胤太祖自古井水脉偶然拾得的避水奇珍，佩之入海可辟易万丈深海重压与乱流暗礁，连同皇室宝库珍藏的这十八株三阶大药，还请少侠务必收下，助少侠横渡东海寻访陆伯父！",
      "tts_text": "[softly] [dramatically] 陆少侠批碎永夜、斩灭国师，于我【烬昼】亿万生灵有再造天地之大恩，我等无以为报。这枚【定海龙珠】乃是昔年大胤太祖自古井水脉偶然拾得的避水奇珍，佩之入海可辟易万丈深海重压与乱流暗礁，连同皇室宝库珍藏的这十八株三阶大药，还请少侠务必收下，助少侠横渡东海寻访陆伯父！",
      "stability": 0.5,
      "similarity_boost": 0.85,
      "acoustic_space": "dry",
      "motif_id": "",
      "sfx_prompt": "",
      "duration_seconds": 2.5,
      "prompt_influence": 0.55,
      "loop": false,
      "placement": "sequential",
      "gain_db": 0.0,
      "gap_after_s": 0.32,
      "director_note": "沈烛音奉上定海龙珠与十八株三阶大药"
    },
    {
      "cue_id": "c016_nar_p020",
      "act_id": "act2_city_gate_farewell_dragon_pearl",
      "kind": "dialogue",
      "role_id": "narrator",
      "speaker_name": "",
      "text": "陆烬看了一眼那枚灵气逼人的【定海龙珠】。跨界水脉不同于陆地古道，深海界壁暗流凶险莫测，有此避水异宝护身，确实能省去大半真元损耗，至于三阶灵药更是日后炼制金丹破境宝丹与替父亲调理伤势的刚需之物。",
      "tts_text": "",
      "stability": 0.5,
      "similarity_boost": 0.85,
      "acoustic_space": "dry",
      "motif_id": "",
      "sfx_prompt": "",
      "duration_seconds": 2.5,
      "prompt_influence": 0.55,
      "loop": false,
      "placement": "sequential",
      "gain_db": 0.0,
