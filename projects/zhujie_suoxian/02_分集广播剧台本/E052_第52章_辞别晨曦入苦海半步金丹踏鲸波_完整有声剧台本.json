    {
      "cue_id": "c014_nar_p016",
      "act_id": "act2_city_gate_farewell_dragon_pearl",
      "kind": "dialogue",
      "role_id": "narrator",
      "speaker_name": "",
      "text": "目送雷横远去，城楼台阶下方走上来一袭素雅青裙、已不再蒙着黑布的沈烛音，身后跟着十余名神色肃穆的守昼族老。站在灿烂金色的朝阳之下，沈烛音清丽端庄的面容愈发明艳动人，她双手捧着一只雕刻着沧海龙纹的紫金宝匣走到陆烬面前，郑重打开匣盖。只见宝匣左侧躺着一枚鸽卵大小、通体蔚蓝澄澈、内里仿佛有一条微型水龙游动不休的奇异宝珠，右侧以及随行族老托盘上，则整整齐齐码放着十余只封存着千年海参、紫玉灵芝等三阶灵药的寒玉盒！",
      "tts_text": "",
      "stability": 0.5,
      "similarity_boost": 0.85,
      "acoustic_space": "dry",
      "motif_id": "",
      "sfx_prompt": "",
