    },
    {
      "cue_id": "c003_nar_p005",
      "act_id": "act1_morning_healing_reborn_capital",
      "kind": "dialogue",
      "role_id": "narrator",
      "speaker_name": "",
      "text": "陆烬收回手掌，没有立刻冒失跳入井底漩涡，而是御风腾空飞出古井，先寻了一处沐浴在晨光下的僻静偏殿盘膝调息了半日。先前硬扛燃灯国师那记金丹骨火印留下的左肩骨裂暗伤，在【方寸墟界】第八环一滴息壤灵液与新晋半步金丹的磅礴暗金真元冲刷之下，发出阵阵细密麻痒的骨膜愈合轻响，不出两个时辰便彻底恢复如初，气血比大战前更加凝练浑厚。待陆烬推开殿门走出之时，外头的【永夜圣京】早已彻底换了一番天地。",
      "tts_text": "",
      "stability": 0.5,
      "similarity_boost": 0.85,
      "acoustic_space": "dry",
      "motif_id": "",
      "sfx_prompt": "",
      "duration_seconds": 2.5,
      "prompt_influence": 0.55,
      "loop": false,
      "placement": "sequential",
      "gain_db": 0.0,
      "gap_after_s": 0.28,
