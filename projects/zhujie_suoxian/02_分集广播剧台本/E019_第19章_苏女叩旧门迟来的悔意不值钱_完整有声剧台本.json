      "placement": "sequential",
      "gain_db": 0.0,
      "gap_after_s": 0.32,
      "director_note": "陆烬原话奉还五十灵石两清因果"
    },
    {
      "cue_id": "c023_nar_p025",
      "act_id": "act2_su_qinghan_begs_at_gate",
      "kind": "dialogue",
      "role_id": "narrator",
      "text": "福伯腰杆一挺，走回大门内侧，原封不动地将这几句话冷冷传了出去。门外雨幕中，苏清寒哭声戛然而止，整个人如坠冰窟般僵在石阶上！她听懂了！二十多天前她居高临下扔在桌上的那句“大道无情，自此两清”，今夜化作了一把最锋利的回旋软刀，一字不差地扎回了她自己的心口！",
      "tts_text": "",
      "stability": 0.5,
      "similarity_boost": 0.85,
